{
  "name": "gestock",
  "private": true,
  "version": "1.0.0",
  "description": "GeStock — Logiciel de gestion commerciale (stock, achats, ventes, caisse, finance)",
  "author": "GeStock",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "seed:admin": "node server/seed-admin.mjs",
    "icon": "node scripts/make-icon.mjs",
    "desktop": "npm run build && electron .",
    "bundle:server": "node scripts/bundle-server.mjs",
    "pack:dir": "npm run build && npm run bundle:server && node scripts/dist-dir.mjs",
    "dist:win": "npm run build && npm run bundle:server && node scripts/dist-win.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>['dist'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.gestock.app",
    "productName": "GeStock",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/server.bundle.mjs",
      "electron/**/*",
      "build/icon.*",
      "package.json",
      "!*.bat",
      "!.env*"
    ],
    "asarUnpack": [
      "server/server.bundle.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GeStock-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GeStock",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1036",
      "displayLanguageSelector": false
    }
  }
}
